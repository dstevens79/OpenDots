# ACTUALLY Open Dots: the UI opens in setup state until these fields are configured.
# Development stays local; the Ubuntu installer binds 0.0.0.0 by default.
HOST=127.0.0.1
PORT=4310
DATABASE_PATH=data/opendots.sqlite
# Keep OWNER_ID stable: it owns the local SQLite conversations.
OWNER_ID=opendots-owner
# npm run dev allows http://localhost:5173 and http://127.0.0.1:5173.
# APP_ORIGIN replaces these defaults with comma-separated exact origins. Set
# it to the public HTTPS origin when TLS terminates at a reverse proxy.
# Include scheme, hostname and port; omit paths and trailing slashes.
# APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Set by the Ubuntu installer when LAN access is enabled.
# OWNER_PASSWORD_HASH=
# RUNTIME_TOKEN is generated privately for local service requests; do not share it.
# RUNTIME_TOKEN=

# ACTUALLY Open Dots uses CopilotKit's local SSE runtime; conversations do not require a hosted service.
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_TURN_TIMEOUT_MS=300000
OPENAI_MODEL=
# Local self-hosted defaults leave telemetry off.
# Optional sampling override (default 1):
# COPILOTKIT_TELEMETRY_SAMPLE_RATE=1
COPILOTKIT_TELEMETRY_DISABLED=true
DO_NOT_TRACK=1

# Optional isolated read-only public-page browser for WEB_SEARCH_PROVIDER=browser.
BROWSER_URL=http://127.0.0.1:4311
BROWSER_SECRET=
BROWSER_HOST=127.0.0.1
BROWSER_PORT=4311
# Use the same random 24+ character secret in app/browser. All redirects are blocked.
# Supply canonical public URLs. The browser helper runs as a separate local service.

# Optional remote realtime voice endpoint. Audio is sent to this configured provider.
VOICE_API_KEY=
VOICE_MODEL=
VOICE_NAME=marin

# Optional persistent computers, one per Dot, using OpenBot services.
# See docs/COMPUTERS.md. Keep these two different random secrets on the server.
COMPUTER_SUPERVISOR_URL=
COMPUTER_SUPERVISOR_TOKEN=
COMPUTER_TOKEN=
# Set COMPUTER_MODE=local-chrome to use a same-machine Chrome profile service
# through the authenticated host manager. See docs/COMPUTERS.md.
COMPUTER_MODE=managed

# Optional private host harness manager for machine-level CLI/service installs.
# The installer writes the private bearer token into .env automatically.
# HARNESS_MANAGER_URL=http://127.0.0.1:4312
# HARNESS_MANAGER_TOKEN=

# Public-web provider. parallel (default), browser (URL-only), or disabled.
# Queries and selected URLs are sent to Parallel; sample mode makes no provider calls.
WEB_SEARCH_PROVIDER=disabled
# Optional Bearer key for production/higher limits; anonymous MCP supports light use.
PARALLEL_API_KEY=
